{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@aila/runtime": ["./src/runtime/index.ts"],
      "@aila/runtime/core": ["./src/runtime/core.ts"],
      "@aila/runtime/node": ["./src/runtime/node.ts"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["scripts/runtime-package-consumer-contract.ts"]
}
