{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@aila/agent": ["./packages/agent/src/index.ts"],
      "@aila/agent/node": ["./packages/agent/src/node.ts"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["scripts/runtime-package-consumer-contract.ts"]
}
