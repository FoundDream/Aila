{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "out/tsconfig.web.tsbuildinfo",
    "jsx": "react-jsx",
    "paths": {
      "@aila/agent/host": ["../../packages/agent/src/host.ts"],
      "@aila/agent": ["../../packages/agent/src/index.ts"],
      "@aila/agent-node/app": ["../../packages/agent-node/src/app/index.ts"],
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
