{
  "name": "Aila",
  "version": "0.1.0",
  "private": true,
  "description": "Aila is a desktop AI agent that helps you with your daily tasks.",
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "tui": "bun src/tui/index.ts",
    "cli": "bun src/cli/index.ts",
    "build": "electron-vite build",
    "typecheck:agent": "tsc --noEmit -p tsconfig.runtime.json --composite false",
    "typecheck:agent-package": "tsc --noEmit -p tsconfig.runtime-package.json --composite false",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:agent && bun run typecheck:agent-package && bun run typecheck:node && bun run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "bun run build && electron-builder --mac",
    "build:win": "bun run build && electron-builder --win",
    "build:linux": "bun run build && electron-builder --linux",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test:runtime": "bun scripts/runtime-contract.ts",
    "test:desktop": "bun scripts/desktop-workbench-contract.ts",
    "test:cli": "bun scripts/cli-contract.ts",
    "test:tui": "bun scripts/tui-contract.ts",
    "test": "bun run test:runtime && bun run test:desktop && bun run test:cli && bun run test:tui"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/openai": "^3.0.58",
    "@aila/agent": "workspace:*",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@uiw/react-codemirror": "^4.25.9",
    "ai": "^6.0.174",
    "chalk": "5.4.1",
    "cli-highlight": "2.1.11",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "unified": "^11.0.5",
    "use-stick-to-bottom": "^1.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
