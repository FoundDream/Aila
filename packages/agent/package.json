{
  "name": "@aila/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aila agent runtime core.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false",
    "test": "bun ../../scripts/runtime-core-surface-contract.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "sideEffects": false
}
