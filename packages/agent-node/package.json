{
  "name": "@aila/agent-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js host adapters for the Aila agent runtime.",
  "exports": {
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "dependencies": {
    "@aila/agent": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "sideEffects": false
}
