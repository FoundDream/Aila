# Required: get one from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id. Pick from https://openrouter.ai/models
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Optional: shown to OpenRouter for routing analytics
OPENROUTER_APP_NAME=Aila

# Optional: enables the `web_search` tool. Get one from https://app.tavily.com/
TAVILY_API_KEY=
