{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/cli/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/runtime/**/*",
    "src/shared/**/*",
    "src/tui/**/*",
    "scripts/**/*"
  ],
  "exclude": ["scripts/runtime-package-consumer-contract.ts"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "out/tsconfig.node.tsbuildinfo",
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
